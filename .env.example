# OpenAI API Key (시뮬레이션 및 에이전트 분석용)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 모델 설정 (기본값: gpt-4o-mini 또는 gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Optional alternate name supported by managed cloud secret bindings.
# ECHOCHAMBER_API_KEY=

# Optional: point to a persistent volume for production run history.
# ECHOCHAMBER_DB_PATH=/var/data/echochamber.sqlite3

# Public demo defaults. Override false locally only when editing master data.
LLM_DAILY_UNIT_CAP=100
LLM_REQUESTS_PER_HOUR=10
DEMO_READ_ONLY=true
DISABLE_DOCS=true
# Comma-separated exact frontend origins; empty for same-origin hosting.
CORS_ORIGINS=
# Optional persistent quota DB; defaults to ECHOCHAMBER_DB_PATH.
# ECHOCHAMBER_LIMITS_DB_PATH=/var/data/echochamber.sqlite3

# Optional YouTube Data API v3 key: server only, never Vite/browser config.
# YOUTUBE_API_KEY=
COLLECTION_REQUESTS_PER_HOUR=10
COLLECTION_DAILY_CALL_CAP=200
