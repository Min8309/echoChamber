# OpenAI API Key (시뮬레이션 및 에이전트 분석용)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 모델 설정 (기본값: gpt-4o-mini 또는 gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Optional alternate name supported by managed cloud secret bindings.
# ECHOCHAMBER_API_KEY=

# Optional: point to a persistent volume for production run history.
# ECHOCHAMBER_DB_PATH=/var/data/echochamber.sqlite3
